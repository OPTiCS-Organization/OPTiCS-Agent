PORT=5230

# 원격 Hub에 연결하는 경우 기본값을 그대로 쓰고,
# 로컬에서 Hub를 띄워 테스트하는 경우 두 URL을 host.docker.internal로 바꿔주세요.
HUB_API_URL=https://api.optics.run
# HUB_API_URL=http://host.docker.internal:3000
HUB_TUNNEL_URL=https://tunnel.optics.run
# HUB_TUNNEL_URL=http://host.docker.internal:5220

OPTICS_SOURCE_URL=https://www.github.com/OPTiCS-Organization
REMOTE_DOCKER_HOST=localhost
REMOTE_DOCKER_PORT=2375

# Optional. Container runtime defaults to file:/app/data/data.db.
DATABASE_URL="file:/app/data/data.db"

CORS_ORIGIN=http://localhost:5240

# Agent 호스트 SSH 접속 설정. install-agent.sh가 자동으로 채워줍니다.
# 수동 설치 시엔 비밀번호 또는 개인 키 중 하나를 사용하세요.
HOST_SSH_HOST=host.docker.internal
HOST_SSH_PORT=22
# HOST_SSH_USERNAME=optics
# Compose가 호스트에서 읽을 개인 키 절대 경로입니다.
# HOST_SSH_PRIVATE_KEY_FILE=/home/user/.local/share/optics/ssh/agent_host_ed25519
# HOST_SSH_PASSWORD=CHANGE_ME
# HOST_SSH_PRIVATE_KEY_PATH=/run/secrets/host_ssh_key
# HOST_SSH_PRIVATE_KEY_PASSPHRASE=
# 선택: ssh2의 sha256 host hash 값과 일치할 때만 연결합니다.
# HOST_SSH_HOST_HASH=
